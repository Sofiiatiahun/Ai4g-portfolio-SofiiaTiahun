# --- Secrets: never commit these ---
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
credentials.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# --- Node / web app projects ---
node_modules/
dist/
build/
.next/
.cache/

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors ---
.vscode/
.idea/

# --- Large files: link to them instead of committing them ---
*.mp4
*.mov
*.zip
*.ckpt
*.safetensors
*.pt
*.pth
