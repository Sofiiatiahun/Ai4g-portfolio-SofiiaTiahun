      "id": "6bad7218-661f-40cc-a5bd-29849041993a",
      "name": "Aggregate Events",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        464,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const pref = $('Set Preferences').first().json;\nconst tz = pref.timezone || 'Europe/Amsterdam';\nconst agg = $input.first().json;\nconst raw = Array.isArray(agg.events) ? agg.events : [];\n\nfunction parseGraph(dt){ if(!dt) return null; let s=String(dt).trim(); if(!/[zZ]|[+\\-]\\d\\d:?\\d\\d$/.test(s)) s+='Z'; const d=new Date(s); return isNaN(d.getTime())?null:d; }\nfunction localMinOfDay(d){ const p=new Intl.DateTimeFormat('en-GB',{timeZone:tz,hour:'2-digit',minute:'2-digit',hour12:false}).formatToParts(d); let h=0,m=0; for(const x of p){ if(x.type==='hour')h=+x.value; if(x.type==='minute')m=+x.value; } return h*60+m; }\n\nlet meetings = raw\n  .filter(e=>e && e.start && e.end && e.subject)\n  .filter(e=>!e.isCancelled)\n  .filter(e=>String(e.showAs||'busy').toLowerCase()!=='free')\n  .map(e=>({ s:parseGraph(e.start.dateTime||e.start), e:parseGraph(e.end.dateTime||e.end) }))\n  .filter(e=>e.s && e.e && e.e>e.s)\n  .sort((a,b)=>a.s-b.s);\n\nconst gap = Number(pref.back_to_back_gap_minutes ?? 5);\nconst meeting_count = meetings.length;\nlet total_meeting_minutes = 0;\nfor(const m of meetings) total_meeting_minutes += Math.round((m.e-m.s)/60000);\n\nlet back_to_back_count=0, longest_streak_minutes=0;\nif(meetings.length){\n  let streakStart=meetings[0].s, streakEnd=meetings[0].e;\n  for(let i=1;i<meetings.length;i++){\n    const g=(meetings[i].s-meetings[i-1].e)/60000;\n    if(g<=gap){ back_to_back_count++; streakEnd = meetings[i].e>streakEnd?meetings[i].e:streakEnd; }\n    else { longest_streak_minutes=Math.max(longest_streak_minutes, Math.round((streakEnd-streakStart)/60000)); streakStart=meetings[i].s; streakEnd=meetings[i].e; }\n  }\n  longest_streak_minutes=Math.max(longest_streak_minutes, Math.round((streakEnd-streakStart)/60000));\n}\n\nconst lunchStart=Number(pref.lunch_start_hour??12)*60;\nconst lunchEnd=Number(pref.lunch_end_hour??14)*60;\nconst lunchMin=Number(pref.lunch_min_minutes??30);\nconst busy = meetings.map(m=>[localMinOfDay(m.s), localMinOfDay(m.e)]);\nfunction freeGapInWindow(ws,we){\n  const ints=busy.map(b=>[Math.max(b[0],ws),Math.min(b[1],we)]).filter(b=>b[1]>b[0]).sort((a,b)=>a[0]-b[0]);\n  let cursor=ws, best=0, bestStart=ws;\n  for(const b of ints){ if(b[0]>cursor && b[0]-cursor>best){ best=b[0]-cursor; bestStart=cursor; } cursor=Math.max(cursor,b[1]); }\n  if(we-cursor>best){ best=we-cursor; bestStart=cursor; }\n  return {len:best,start:bestStart};\n}\nconst lunchFree=freeGapInWindow(lunchStart,lunchEnd);\nconst no_lunch_break = meeting_count>0 && lunchFree.len < lunchMin;\n\nconst overloadMin=Number(pref.overload_minutes??360);\nconst moderateMin=Number(pref.moderate_minutes??240);\nconst longStreak=Number(pref.long_streak_minutes??180);\nlet workload_level='Light', overload_flag=false;\nif(total_meeting_minutes>=overloadMin || back_to_back_count>=4 || longest_streak_minutes>=longStreak){\n  workload_level='High'; overload_flag = total_meeting_minutes>=overloadMin || back_to_back_count>=4;\n} else if(total_meeting_minutes>=moderateMin){ workload_level='Moderate'; }\n\nfunction localDateStr(d){ return new Intl.DateTimeFormat('en-CA',{timeZone:tz,year:'numeric',month:'2-digit',day:'2-digit'}).format(d); }\nconst refDate = localDateStr(meetings.length?meetings[0].s:new Date());\nfunction localMinToUTCISO(minOfDay){\n  const hh=String(Math.floor(minOfDay/60)).padStart(2,'0');\n  const mm=String(minOfDay%60).padStart(2,'0');\n  const guess=new Date(refDate+'T'+hh+':'+mm+':00Z');\n  const diff=minOfDay-localMinOfDay(guess);\n  return new Date(guess.getTime()+diff*60000).toISOString();\n}\n\nconst maxBreaks=Number(pref.max_breaks??2);\nlet proposed=[];\nif(meeting_count>0){\n  if(no_lunch_break){\n    const start=Math.max(lunchFree.start, lunchStart);\n    proposed.push({ subject:'Lunch break (protected)', startMin:start, endMin:start+lunchMin });\n  }\n  if(longest_streak_minutes>=longStreak){\n    const endLocal=localMinOfDay(meetings[meetings.length-1].e);\n    proposed.push({ subject:'Recovery break', startMin:endLocal, endMin:endLocal+15 });\n  }\n}\nproposed = proposed.slice(0,maxBreaks).map(p=>({ subject:p.subject, start:localMinToUTCISO(p.startMin), end:localMinToUTCISO(p.endMin) }));\n\nconst day_of_week=new Intl.DateTimeFormat('en-US',{timeZone:tz,weekday:'long'}).format(new Date());\nconst fallback_headline = workload_level==='High' ? 'Heads up: a heavy meeting day ahead'\n  : workload_level==='Moderate' ? 'A moderately busy day ahead'\n  : (meeting_count===0 ? 'A clear day — enjoy the focus time' : 'A light meeting day ahead');\nconst fallback_summary = 'You have '+meeting_count+' meeting(s) totalling '+total_meeting_minutes+' min, '+back_to_back_count+' back-to-back, longest stretch '+longest_streak_minutes+' min.'+(no_lunch_break?' No lunch break is currently protected.':'');\nconst metrics_text = 'Meeting count: '+meeting_count+'\\nTotal meeting minutes: '+total_meeting_minutes+'\\nBack-to-back transitions: '+back_to_back_count+'\\nLongest continuous stretch (min): '+longest_streak_minutes+'\\nLunch break protected: '+(no_lunch_break?'no':'yes')+'\\nWorkload level: '+workload_level+'\\nOverload flag: '+overload_flag+'\\nProposed breaks: '+proposed.length;\n\nreturn [{ json: {\n  run_date: refDate, day_of_week, meeting_count, total_meeting_minutes, longest_streak_minutes,\n  back_to_back_count, no_lunch_break, workload_level, overload_flag,\n  breaks_proposed_count: proposed.length, proposed_breaks: proposed,\n  fallback_headline, fallback_summary, metrics_text\n} }];"
      },
