    {
      "parameters": {
        "promptType": "define",
        "text": "=Here are today's aggregate workload metrics (no meeting content):\n\n{{ $json.metrics_text }}\n\nProposed breaks the system may add to the calendar: {{ $json.breaks_proposed_count }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a supportive well-being assistant. Using ONLY the aggregate metrics provided, write an encouraging, non-judgemental daily plan. Do NOT diagnose overload or invent numbers — the numbers and the workload level are already decided by rules. Keep it warm and brief. If the metrics suggest possible loneliness or limited social connection, gently suggest an optional, low-pressure activity such as messaging someone the user trusts, meeting a friend for coffee, taking a walk together, or having lunch with a colleague. Do not present loneliness as a diagnosis or automatically contact anyone. Provide: a short headline, a 1-2 sentence summary, 2-4 concrete supportive recommendations, and a single clear approvalQuestion asking whether to add the proposed break(s) to the calendar."
            }
          ]
        },
        "batching": {}
      },
